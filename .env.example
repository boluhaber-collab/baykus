# PostgreSQL (Docker / varsayılan)
POSTGRES_USER=baykus
POSTGRES_PASSWORD=baykus
POSTGRES_DB=baykus
DATABASE_URL=postgresql+psycopg2://baykus:baykus@localhost:5432/baykus

# Windows (Docker yok) — SQLite kullanmak için yukarıdaki DATABASE_URL satırını
# yorumlayıp aşağıdakini açın. SQLite için Alembic ÇALIŞTIRMAYIN;
# bunun yerine: python -m app.bootstrap_sqlite  (apps/api içinde)
# DATABASE_URL=sqlite:///./baykus.db

# API
SECRET_KEY=baykus-dev-secret-change-in-production
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000
